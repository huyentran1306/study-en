{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-gateway-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-04-24",
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-gateway-db",
      "database_id": "76611f4f-2e43-4dbb-b36c-858ff81298a3"
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
