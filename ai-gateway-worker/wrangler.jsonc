{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-gateway-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-04-24",
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-gateway-db",
      "database_id": "76611f4f-2e43-4dbb-b36c-858ff81298a3"
    }
  ],
  "vars": {
    "VISION_MODEL_PRIMARY": "@cf/meta/llama-3.2-11b-vision-instruct",
    "VISION_MODEL_FALLBACK": "@cf/meta/llama-4-scout-17b-16e-instruct",
    "OCR_PRIMARY_DAILY_NEURONS": 25000,
    "AI_DAILY_SOFT_LIMIT": 45000,
    "AI_DAILY_HARD_LIMIT": 60000,
    "ALLOW_CLIENT_PROMPT": "true",
    "ALLOW_LEGACY_MASTER_SECRET": "true"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
