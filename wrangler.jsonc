{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "study-en",
  "compatibility_date": "2026-04-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "study-en-db",
      "database_id": "f6e2c6e8-d2d0-482d-b98e-efc08d327d06",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
